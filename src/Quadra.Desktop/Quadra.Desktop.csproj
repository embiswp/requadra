<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on the newest installed .NET when .NET 8 itself is not present. -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Quadra</AssemblyName>
    <RootNamespace>Quadra.Desktop</RootNamespace>
  </PropertyGroup>

  <Import Project="..\Quadra.Client.Shared\GameAssets.props" />
  <ItemGroup>
    <Content Include="@(GameAsset)" Link="Assets\%(Folder)\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The game itself is shared with the Android head as source: the two MonoGame packages are separate assemblies. -->
  <ItemGroup>
    <Compile Include="..\Quadra.Client.Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Quadra.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <ProjectReference Include="..\Quadra.Core\Quadra.Core.csproj" />
  </ItemGroup>

</Project>
